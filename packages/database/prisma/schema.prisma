generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Config {
  id                   String   @id @default(cuid())
  baseUrl              String
  allowedOrigins       String
  maxDepth             Int      @default(2)
  concurrency          Int      @default(2)
  delayMs              Int      @default(500)
  maxPages             Int      @default(50)
  excludePatterns      String   @default("")
  authType             String   @default("none")
  authLoginUrl         String?
  authUsername         String?
  authPassword         String?
  authCookie           String?
  authToken            String?
  scheduleEnabled      Boolean  @default(false)
  scheduleCron         String   @default("0 9 * * *")
  scheduleJobType      String   @default("crawl")
  mailEnabled          Boolean  @default(false)
  mailHost             String?
  mailPort             Int      @default(587)
  mailSecure           Boolean  @default(false)
  mailUser             String?
  mailFrom             String?
  mailTo               String?
  mailPassword         String?
  visualDiffThreshold  Float    @default(0.05)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Run {
  id             String     @id @default(cuid())
  status         String
  baseUrl        String
  configSnapshot String // JSON
  findings       String?    // JSON
  startedAt      DateTime   @default(now())
  finishedAt     DateTime?
  pages          Page[]
  scenarios      Scenario[]
}

model Page {
  id             String   @id @default(cuid())
  runId          String
  run            Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  url            String
  title          String?
  depth          Int
  statusCode     Int?
  hasJsError     Boolean  @default(false)
  hasHttpError   Boolean  @default(false)
  consoleLogs    String?  // JSON
  screenshotPath String?
  diffPath       String?
  diffRatio      Float?
  hasVisualDiff  Boolean  @default(false)
  visitedAt      DateTime @default(now())

  @@index([runId])
}

model Scenario {
  id          String        @id @default(cuid())
  name        String
  description String?
  source      String        @default("auto")
  risk        String        @default("safe")
  status      String        @default("active")
  baseUrl     String
  pageUrl     String
  steps       String // JSON
  runId       String?
  run         Run?          @relation(fields: [runId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  runs        ScenarioRun[]

  @@index([runId])
  @@index([status])
  @@index([risk])
}

model ScenarioRun {
  id          String    @id @default(cuid())
  scenarioId  String
  scenario    Scenario  @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  status      String
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  result      String?   // JSON
  findings    String?   // JSON
  error       String?

  @@index([scenarioId])
}

model ApiEndpoint {
  id                String  @id @default(cuid())
  name              String
  method            String  @default("GET")
  url               String
  headers           String? // JSON
  body              String?
  expectedStatus    Int?
  expectedContentType String?
  timeoutMs         Int     @default(5000)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ApiTestRun {
  id          String    @id @default(cuid())
  status      String
  endpoints   String    // JSON snapshot
  results     String?   // JSON
  findings    String?   // JSON
  error       String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
}
