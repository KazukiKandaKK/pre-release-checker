{
  "name": "pre-release-checker",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm-run-all -s build:shared build:storage build:db build:api build:runner build:web",
    "build:shared": "npm --prefix packages/shared run build",
    "build:storage": "npm --prefix packages/storage run build",
    "build:db": "npm --prefix packages/database run generate && npm --prefix packages/database run build",
    "build:api": "npm --prefix apps/api run build",
    "build:runner": "npm --prefix apps/runner run build",
    "build:web": "npm --prefix apps/web run build",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:runner\" \"npm run dev:web\"",
    "dev:api": "npm --prefix apps/api run dev",
    "dev:runner": "npm --prefix apps/runner run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "db:generate": "npm --prefix packages/database run generate",
    "db:migrate": "npm --prefix packages/database run migrate",
    "db:studio": "npm --prefix packages/database run studio",
    "typecheck": "npm-run-all -p typecheck:*",
    "typecheck:shared": "npm --prefix packages/shared run typecheck",
    "typecheck:storage": "npm --prefix packages/storage run typecheck",
    "typecheck:db": "npm --prefix packages/database run typecheck",
    "typecheck:api": "npm --prefix apps/api run typecheck",
    "typecheck:runner": "npm --prefix apps/runner run typecheck",
    "typecheck:web": "npm --prefix apps/web run typecheck",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
